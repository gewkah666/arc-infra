# Arc stack-wide environment variables
#
# Copy this file to `.env` (gitignored) and edit values for local dev.
# In production, these are set via docker-compose environment: blocks or the
# deployment platform's secret store.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arc

# --- Gateway ---
APP__DATABASE_URL=postgresql://postgres:postgres@db:5432/arc
APP__REDIS_URL=redis://redis:6379/0
APP__RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
APP__POSE_SERVICE_URL=pose-service:50051
APP__VIDEO_UPLOAD_DIR=/app/data/videos
APP__JWT_SECRET=dev-secret-key-change-in-production
APP__JWT_EXPIRATION_HOURS=24
APP__SERVER_HOST=0.0.0.0
APP__SERVER_PORT=8000
APP__ADMIN_INITIAL_USERNAME=admin
APP__ADMIN_INITIAL_PASSWORD=admin123

# --- Core / Celery ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/arc
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
VIDEO_UPLOAD_DIR=/app/data/videos
MEDIAPIPE_POSE_MODEL_PATH=/app/models/pose_landmarker_lite.task